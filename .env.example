# Deployed FaceNotary Smart Contract Address
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Optional: Set to 1 to enable strict RPC requirement (fails if node unreachable)
RPC_STRICT=0
